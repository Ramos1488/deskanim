<Window x:Class="DeskAnim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskAnim" Width="560" Height="420" WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Add files…" Margin="8,0,0,0" Padding="12,5"
                    Click="AddBtn_Click" />
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
        </DockPanel>

        <ListBox x:Name="List" Grid.Row="1" DisplayMemberPath="Title"
                 SelectionMode="Extended" KeyDown="List_KeyDown"
                 MouseDoubleClick="List_MouseDoubleClick" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Place on desktop" Padding="12,5" Margin="0,0,8,0" Click="Place_Click" />
            <Button Content="Delete" Padding="12,5" Margin="0,0,8,0" Click="Delete_Click" />
            <Button Content="Remove all" Padding="12,5" Click="Clear_Click" />
        </StackPanel>
    </Grid>
</Window>
